MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.fullBattery.status = success) | (system.fullBattery.status = failure)));
LTLSPEC G(((system.fullBattery.status = success) -> X(((system.isCharge.status = success) | (system.isCharge.status = failure)))));
LTLSPEC G(((system.fullBattery.status = failure) -> X(((system.lowBattery.status = success) | (system.lowBattery.status = failure)))));
LTLSPEC G(((system.isCharge.status = success) -> X(((system.stopCharge.status = success) | (system.stopCharge.status = failure) | (system.stopCharge.status = running)))));
LTLSPEC G(((system.isCharge.status = failure) -> X(((system.lowBattery.status = success) | (system.lowBattery.status = failure)))));
LTLSPEC G(((system.stopCharge.status = success) -> X(((system.fullBattery.status = success) | (system.fullBattery.status = failure)))));
LTLSPEC G(((system.lowBattery.status = success) -> X(((system.connectToStation.status = success) | (system.connectToStation.status = failure) | (system.connectToStation.status = running)))));
LTLSPEC G(((system.lowBattery.status = failure) -> X(((system.askHelp.status = success) | (system.askHelp.status = failure) | (system.askHelp.status = running)))));
LTLSPEC G(((system.connectToStation.status = success) -> X(((system.charging.status = success) | (system.charging.status = failure) | (system.charging.status = running)))));
LTLSPEC G(((system.charging.status = success) -> X(((system.fullBattery.status = success) | (system.fullBattery.status = failure)))));
LTLSPEC G(((system.askHelp.status = success) -> X(((system.goToStation.status = success) | (system.goToStation.status = failure) | (system.goToStation.status = running)))));
LTLSPEC G(((system.goToStation.status = success) -> X(((system.waitCharge.status = success) | (system.waitCharge.status = failure) | (system.waitCharge.status = running)))));
LTLSPEC G(((system.waitCharge.status = success) -> X(((system.fullBattery.status = success) | (system.fullBattery.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        fullBattery : fullBattery_module(fullBattery_v_stage_0);
        isCharge : isCharge_module(isCharge_v_stage_0);
        stopCharge : success_DEFAULT_module();
        c1 : composite_sequence_without_memory_3(fullBattery, isCharge, stopCharge);
        lowBattery : lowBattery_module(lowBattery_v_stage_0);
        connectToStation : success_DEFAULT_module();
        charging : success_DEFAULT_module();
        c2 : composite_sequence_without_memory_3(lowBattery, connectToStation, charging);
        askHelp : success_DEFAULT_module();
        goToStation : success_DEFAULT_module();
        waitCharge : success_DEFAULT_module();
        c3 : composite_sequence_without_memory_3(askHelp, goToStation, waitCharge);
        c0 : composite_selector_without_memory_3(c1, c2, c3);
        --START OF BLACKBOARD VARIABLES DECLARATION
        fullBattery_v_stage_0 : boolean;
        isCharge_v_stage_0 : boolean;
        lowBattery_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(fullBattery_v_stage_0) := {TRUE, FALSE};
        init(isCharge_v_stage_0) := {TRUE, FALSE};
        init(lowBattery_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(fullBattery_v_stage_0) :=
            case
                !(c0.active) : fullBattery_v_stage_0;
                TRUE : fullBattery_v_stage_0;
            esac;
        next(isCharge_v_stage_0) :=
            case
                !(c0.active) : isCharge_v_stage_0;
                TRUE : isCharge_v_stage_0;
            esac;
        next(lowBattery_v_stage_0) :=
            case
                !(c0.active) : lowBattery_v_stage_0;
                TRUE : lowBattery_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        c1 := 1;
        fullBattery := 2;
        isCharge := 3;
        stopCharge := 4;
        c2 := 5;
        lowBattery := 6;
        connectToStation := 7;
        charging := 8;
        c3 := 9;
        askHelp := 10;
        goToStation := 11;
        waitCharge := 12;
MODULE composite_selector_without_memory_3(child_0, child_1, child_2)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = failure) : child_0.internal_status;
                !(child_1.internal_status = failure) : child_1.internal_status;
                !(child_2.internal_status = failure) : child_2.internal_status;
                TRUE : failure;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = failure;
        child_2.active := child_1.status = failure;
MODULE composite_sequence_without_memory_3(child_0, child_1, child_2)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                !(child_2.internal_status = success) : child_2.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
        child_2.active := child_1.status = success;
MODULE fullBattery_module(fullBattery_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (fullBattery_v_stage_0) ? success : failure;
MODULE isCharge_module(isCharge_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (isCharge_v_stage_0) ? success : failure;
MODULE lowBattery_module(lowBattery_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (lowBattery_v_stage_0) ? success : failure;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
