MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.atPos3.status = success) | (system.atPos3.status = failure)));
LTLSPEC G(((system.atPos3.status = success) -> X(((system.atPos2.status = success) | (system.atPos2.status = failure)))));
LTLSPEC G(((system.atPos3.status = failure) -> X(((system.move1to3.status = success) | (system.move1to3.status = failure) | (system.move1to3.status = running)))));
LTLSPEC G(((system.move1to3.status = success) -> X(((system.atPos2.status = success) | (system.atPos2.status = failure)))));
LTLSPEC G(((system.atPos2.status = success) -> X(((system.atPos3.status = success) | (system.atPos3.status = failure)))));
LTLSPEC G(((system.atPos2.status = failure) -> X(((system.move3to2.status = success) | (system.move3to2.status = failure) | (system.move3to2.status = running)))));
LTLSPEC G(((system.move3to2.status = success) -> X(((system.atPos3.status = success) | (system.atPos3.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        atPos3 : atPos3_module(atPos3_v_stage_0);
        move1to3 : success_DEFAULT_module();
        c1 : composite_selector_without_memory_2(atPos3, move1to3);
        atPos2 : atPos2_module(atPos2_v_stage_0);
        move3to2 : success_DEFAULT_module();
        c2 : composite_selector_without_memory_2(atPos2, move3to2);
        c0 : composite_sequence_without_memory_2(c1, c2);
        --START OF BLACKBOARD VARIABLES DECLARATION
        atPos3_v_stage_0 : boolean;
        atPos2_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(atPos3_v_stage_0) := {TRUE, FALSE};
        init(atPos2_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(atPos3_v_stage_0) :=
            case
                !(c0.active) : atPos3_v_stage_0;
                TRUE : atPos3_v_stage_0;
            esac;
        next(atPos2_v_stage_0) :=
            case
                !(c0.active) : atPos2_v_stage_0;
                TRUE : atPos2_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        c1 := 1;
        atPos3 := 2;
        move1to3 := 3;
        c2 := 4;
        atPos2 := 5;
        move3to2 := 6;
MODULE composite_sequence_without_memory_2(child_0, child_1)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
MODULE composite_selector_without_memory_2(child_0, child_1)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = failure) : child_0.internal_status;
                !(child_1.internal_status = failure) : child_1.internal_status;
                TRUE : failure;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = failure;
MODULE atPos3_module(atPos3_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (atPos3_v_stage_0) ? success : failure;
MODULE atPos2_module(atPos2_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (atPos2_v_stage_0) ? success : failure;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
