LTLSPEC G(((system.TargetAdjacent.status = failure) -> X(((system.atPosA.status = success) | (system.atPosA.status = failure)))));
LTLSPEC G(((system.attackTarget.status = success) -> X(((system.taskFinishedA.status = success) | (system.taskFinishedA.status = failure)))));
LTLSPEC G(((system.taskFinishedA.status = success) -> X(((system.atPosA.status = success) | (system.atPosA.status = failure)))));
LTLSPEC G(((system.taskFinishedA.status = failure) -> X(((system.atPosA.status = success) | (system.atPosA.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
