        TargetAdjacent : TargetAdjacent_module(TargetAdjacent_v_stage_0);
        attackTarget : success_DEFAULT_module();
        taskFinishedA : taskFinishedA_module(taskFinishedA_v_stage_0);
        c0 : composite_sequence_without_memory_7(atPosA, doTaskA, getTarget, moveToDestination, TargetAdjacent, attackTarget, taskFinishedA);
