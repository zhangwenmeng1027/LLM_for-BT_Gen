        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.atPosA.status = success) | (system.atPosA.status = failure)));
LTLSPEC G(((system.atPosA.status = success) -> X(((system.doTaskA.status = success) | (system.doTaskA.status = failure) | (system.doTaskA.status = running)))));
LTLSPEC G(((system.atPosA.status = failure) -> X(((system.atPosA.status = success) | (system.atPosA.status = failure)))));
LTLSPEC G(((system.doTaskA.status = success) -> X(((system.getTarget.status = success) | (system.getTarget.status = failure) | (system.getTarget.status = running)))));
