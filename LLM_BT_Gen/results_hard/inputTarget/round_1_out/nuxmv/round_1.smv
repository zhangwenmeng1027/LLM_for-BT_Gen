LTLSPEC G(((system.TargetFound.status = failure) -> X(((system.TargetCaptured.status = success) | (system.TargetCaptured.status = failure)))));
LTLSPEC G(((system.openGripper.status = success) -> X(((system.pickUp.status = success) | (system.pickUp.status = failure) | (system.pickUp.status = running)))));
LTLSPEC G(((system.pickUp.status = success) -> X(((system.closeGripper.status = success) | (system.closeGripper.status = failure) | (system.closeGripper.status = running)))));
LTLSPEC G(((system.closeGripper.status = success) -> X(((system.acceptInput.status = success) | (system.acceptInput.status = failure)))));
LTLSPEC G(((system.TargetCaptured.status = success) -> X(((system.goToTarRoom.status = success) | (system.goToTarRoom.status = failure) | (system.goToTarRoom.status = running)))));
LTLSPEC G(((system.TargetCaptured.status = failure) -> X(((system.lowBattery.status = success) | (system.lowBattery.status = failure)))));
LTLSPEC G(((system.goToTarRoom.status = success) -> X(((system.putDown.status = success) | (system.putDown.status = failure) | (system.putDown.status = running)))));
LTLSPEC G(((system.putDown.status = success) -> X(((system.acceptInput.status = success) | (system.acceptInput.status = failure)))));
LTLSPEC G(((system.lowBattery.status = success) -> X(((system.goToStation.status = success) | (system.goToStation.status = failure) | (system.goToStation.status = running)))));
LTLSPEC G(((system.lowBattery.status = failure) -> X(((system.acceptInput.status = success) | (system.acceptInput.status = failure)))));
LTLSPEC G(((system.goToStation.status = success) -> X(((system.charging.status = success) | (system.charging.status = failure) | (system.charging.status = running)))));
LTLSPEC G(((system.charging.status = success) -> X(((system.acceptInput.status = success) | (system.acceptInput.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        acceptInput : success_DEFAULT_module();
        setValue : success_DEFAULT_module();
        BatteryOK : BatteryOK_module(BatteryOK_v_stage_0);
        searchTarget : success_DEFAULT_module();
        TargetFound : TargetFound_module(TargetFound_v_stage_0);
        openGripper : success_DEFAULT_module();
        pickUp : success_DEFAULT_module();
        closeGripper : success_DEFAULT_module();
        c4 : composite_sequence_without_memory_4(TargetFound, openGripper, pickUp, closeGripper);
        TargetCaptured : TargetCaptured_module(TargetCaptured_v_stage_0);
        goToTarRoom : success_DEFAULT_module();
        putDown : success_DEFAULT_module();
        c5 : composite_sequence_without_memory_3(TargetCaptured, goToTarRoom, putDown);
        c3 : composite_selector_without_memory_2(c4, c5);
        c2 : composite_sequence_without_memory_3(BatteryOK, searchTarget, c3);
        lowBattery : lowBattery_module(lowBattery_v_stage_0);
        goToStation : success_DEFAULT_module();
        charging : success_DEFAULT_module();
        c6 : composite_sequence_without_memory_3(lowBattery, goToStation, charging);
        c1 : composite_selector_without_memory_2(c2, c6);
        c0 : composite_sequence_without_memory_3(acceptInput, setValue, c1);
        --START OF BLACKBOARD VARIABLES DECLARATION
        BatteryOK_v_stage_0 : boolean;
        lowBattery_v_stage_0 : boolean;
        TargetFound_v_stage_0 : boolean;
        TargetCaptured_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(BatteryOK_v_stage_0) := {TRUE, FALSE};
        init(lowBattery_v_stage_0) := {TRUE, FALSE};
        init(TargetFound_v_stage_0) := {TRUE, FALSE};
        init(TargetCaptured_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(BatteryOK_v_stage_0) :=
            case
                !(c0.active) : BatteryOK_v_stage_0;
                TRUE : BatteryOK_v_stage_0;
            esac;
        next(lowBattery_v_stage_0) :=
            case
                !(c0.active) : lowBattery_v_stage_0;
                TRUE : lowBattery_v_stage_0;
            esac;
        next(TargetFound_v_stage_0) :=
            case
                !(c0.active) : TargetFound_v_stage_0;
                TRUE : TargetFound_v_stage_0;
            esac;
        next(TargetCaptured_v_stage_0) :=
            case
                !(c0.active) : TargetCaptured_v_stage_0;
                TRUE : TargetCaptured_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        acceptInput := 1;
        setValue := 2;
        c1 := 3;
