LTLSPEC G(((system.setValue.status = success) -> X(((system.BatteryOK.status = success) | (system.BatteryOK.status = failure)))));
LTLSPEC G(((system.BatteryOK.status = success) -> X(((system.searchTarget.status = success) | (system.searchTarget.status = failure) | (system.searchTarget.status = running)))));
LTLSPEC G(((system.BatteryOK.status = failure) -> X(((system.lowBattery.status = success) | (system.lowBattery.status = failure)))));
LTLSPEC G(((system.searchTarget.status = success) -> X(((system.TargetFound.status = success) | (system.TargetFound.status = failure)))));
