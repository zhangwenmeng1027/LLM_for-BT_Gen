MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.getTarget.status = success) | (system.getTarget.status = failure)));
LTLSPEC G(((system.getTarget.status = success) -> X(((system.moveToDestination.status = success) | (system.moveToDestination.status = failure) | (system.moveToDestination.status = running)))));
LTLSPEC G(((system.moveToDestination.status = success) -> X(((system.TargetAdjacent.status = success) | (system.TargetAdjacent.status = failure)))));
LTLSPEC G(((system.TargetAdjacent.status = success) -> X(((system.attackTarget.status = success) | (system.attackTarget.status = failure) | (system.attackTarget.status = running)))));
LTLSPEC G(((system.TargetAdjacent.status = failure) -> X(((system.randomMove.status = success) | (system.randomMove.status = failure) | (system.randomMove.status = running)))));
LTLSPEC G(((system.attackTarget.status = success) -> X(((system.getTarget.status = success) | (system.getTarget.status = failure)))));
LTLSPEC G(((system.randomMove.status = success) -> X(((system.getTarget.status = success) | (system.getTarget.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        getTarget : success_DEFAULT_module();
        moveToDestination : success_DEFAULT_module();
        TargetAdjacent : TargetAdjacent_module(TargetAdjacent_v_stage_0);
        attackTarget : success_DEFAULT_module();
        c1 : composite_sequence_without_memory_4(getTarget, moveToDestination, TargetAdjacent, attackTarget);
        randomMove : success_DEFAULT_module();
        c0 : composite_selector_without_memory_2(c1, randomMove);
        --START OF BLACKBOARD VARIABLES DECLARATION
        TargetAdjacent_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(TargetAdjacent_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(TargetAdjacent_v_stage_0) :=
            case
                !(c0.active) : TargetAdjacent_v_stage_0;
                TRUE : TargetAdjacent_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        c1 := 1;
        getTarget := 2;
        moveToDestination := 3;
        TargetAdjacent := 4;
        attackTarget := 5;
        randomMove := 6;
MODULE composite_sequence_without_memory_4(child_0, child_1, child_2, child_3)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                !(child_2.internal_status = success) : child_2.internal_status;
                !(child_3.internal_status = success) : child_3.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
        child_2.active := child_1.status = success;
        child_3.active := child_2.status = success;
MODULE composite_selector_without_memory_2(child_0, child_1)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = failure) : child_0.internal_status;
                !(child_1.internal_status = failure) : child_1.internal_status;
                TRUE : failure;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = failure;
MODULE TargetAdjacent_module(TargetAdjacent_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (TargetAdjacent_v_stage_0) ? success : failure;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
