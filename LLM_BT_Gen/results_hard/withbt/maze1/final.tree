configuration {} enumerations {} constants {}
variables {
    variable { env atPosA_v VAR BOOLEAN assign{result{True, False}} }
    variable { env atPosB_v VAR BOOLEAN assign{result{True, False}} }
}
environment_update {
    variable_statement{ atPosA_v assign{result{atPosA_v}} }
    variable_statement{ atPosB_v assign{result{atPosB_v}} }
}
checks {}
environment_checks {
    environment_check { atPosA arguments {} read_variables {atPosA_v} condition{atPosA_v} }
    environment_check { atPosB arguments {} read_variables {atPosB_v} condition{atPosB_v} }
}
actions {
    action { moveDown
        arguments {} local_variables{} read_variables{} write_variables{} initial_values{}
        update { return_statement{result{success}} }
    }
    action { moveRight
        arguments {} local_variables{} read_variables{} write_variables{} initial_values{}
        update { return_statement{result{success}} }
    }
}
sub_trees {}
tree {
    composite {
        c0 sequence
        children {
            composite {
                c1 selector
                children {
                    atPosA {}
                    moveDown {}
                }
            }
            composite {
                c2 selector
                children {
                    atPosB {}
                    moveRight {}
                }
            }
        }
    }
}
tick_prerequisite {True}
specifications {
    LTLSPEC {(next, (or, (success, atPosA), (failure, atPosA)))}
    LTLSPEC {(globally, (implies, (success, atPosA), (next, (or, (success, atPosB), (failure, atPosB)))))}
    LTLSPEC {(globally, (implies, (failure, atPosA), (next, (or, (success, moveDown), (failure, moveDown), (running, moveDown)))))}
    LTLSPEC {(globally, (implies, (success, moveDown), (next, (or, (success, atPosB), (failure, atPosB)))))}
    LTLSPEC {(globally, (implies, (success, atPosB), (next, (or, (success, atPosA), (failure, atPosA)))))}
    LTLSPEC {(globally, (implies, (failure, atPosB), (next, (or, (success, moveRight), (failure, moveRight), (running, moveRight)))))}
    LTLSPEC {(globally, (implies, (success, moveRight), (next, (or, (success, atPosA), (failure, atPosA)))))}
}
