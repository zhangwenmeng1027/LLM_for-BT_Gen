MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.detectionCompleted.status = success) | (system.detectionCompleted.status = failure)));
LTLSPEC G(((system.detectionCompleted.status = success) -> X(((system.generateDetection.status = success) | (system.generateDetection.status = failure) | (system.generateDetection.status = running)))));
LTLSPEC G(((system.detectionCompleted.status = failure) -> X(((system.detectionCompleted.status = success) | (system.detectionCompleted.status = failure)))));
LTLSPEC G(((system.generateDetection.status = success) -> X(((system.moveToDestination.status = success) | (system.moveToDestination.status = failure) | (system.moveToDestination.status = running)))));
LTLSPEC G(((system.moveToDestination.status = success) -> X(((system.detectionCompleted.status = success) | (system.detectionCompleted.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        detectionCompleted : detectionCompleted_module(detectionCompleted_v_stage_0);
        generateDetection : success_DEFAULT_module();
        moveToDestination : success_DEFAULT_module();
        c0 : composite_sequence_without_memory_3(detectionCompleted, generateDetection, moveToDestination);
        --START OF BLACKBOARD VARIABLES DECLARATION
        detectionCompleted_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(detectionCompleted_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(detectionCompleted_v_stage_0) :=
            case
                !(c0.active) : detectionCompleted_v_stage_0;
                TRUE : detectionCompleted_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        detectionCompleted := 1;
        generateDetection := 2;
        moveToDestination := 3;
MODULE composite_sequence_without_memory_3(child_0, child_1, child_2)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                !(child_2.internal_status = success) : child_2.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
        child_2.active := child_1.status = success;
MODULE detectionCompleted_module(detectionCompleted_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (detectionCompleted_v_stage_0) ? success : failure;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
