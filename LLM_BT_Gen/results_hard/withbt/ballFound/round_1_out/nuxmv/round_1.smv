        putDownBall : success_DEFAULT_module();
        c6 : composite_selector_without_memory_2(ballPlaced, putDownBall);
        c0 : composite_sequence_without_memory_6(c1, c2, c3, c4, c5, c6);
        --START OF BLACKBOARD VARIABLES DECLARATION
