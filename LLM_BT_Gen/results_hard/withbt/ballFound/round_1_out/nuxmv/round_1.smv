        init(ballFound_v_stage_0) := {TRUE, FALSE};
        init(ballClose_v_stage_0) := {TRUE, FALSE};
        init(ballGrasped_v_stage_0) := {TRUE, FALSE};
        init(boxFound_v_stage_0) := {TRUE, FALSE};
        init(boxNear_v_stage_0) := {TRUE, FALSE};
        init(ballPlaced_v_stage_0) := {TRUE, FALSE};
