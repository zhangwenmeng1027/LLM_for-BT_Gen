        next(ballFound_v_stage_0) :=
            case
                !(c0.active) : ballFound_v_stage_0;
                TRUE : ballFound_v_stage_0;
            esac;
        next(ballClose_v_stage_0) :=
            case
                !(c0.active) : ballClose_v_stage_0;
