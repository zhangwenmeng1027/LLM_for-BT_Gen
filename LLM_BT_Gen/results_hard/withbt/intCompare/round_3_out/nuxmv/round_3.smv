MODULE equalVal_module(equalVal_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (equalVal_v_stage_0) ? success : failure;
MODULE _DEFAULT_module
