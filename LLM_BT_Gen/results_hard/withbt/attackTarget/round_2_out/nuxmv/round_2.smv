LTLSPEC G(((system.goToPosA.status = success) -> X(((system.TargetAdjacent.status = success) | (system.TargetAdjacent.status = failure)))));
LTLSPEC G(((system.TargetAdjacent.status = success) -> X(((system.getTarget.status = success) | (system.getTarget.status = failure)))));
LTLSPEC G(((system.TargetAdjacent.status = failure) -> X(((system.attackTarget.status = success) | (system.attackTarget.status = failure) | (system.attackTarget.status = running)))));
LTLSPEC G(((system.attackTarget.status = success) -> X(((system.getTarget.status = success) | (system.getTarget.status = failure)))));
LTLSPEC G(((system.isHungry.status = success) -> X(((system.findFood.status = success) | (system.findFood.status = failure) | (system.findFood.status = running)))));
LTLSPEC G(((system.isHungry.status = failure) -> X(((system.followHuman.status = success) | (system.followHuman.status = failure) | (system.followHuman.status = running)))));
LTLSPEC G(((system.findFood.status = success) -> X(((system.goToPosB.status = success) | (system.goToPosB.status = failure) | (system.goToPosB.status = running)))));
LTLSPEC G(((system.goToPosB.status = success) -> X(((system.findTableware.status = success) | (system.findTableware.status = failure) | (system.findTableware.status = running)))));
LTLSPEC G(((system.findTableware.status = success) -> X(((system.eatfood.status = success) | (system.eatfood.status = failure) | (system.eatfood.status = running)))));
LTLSPEC G(((system.eatfood.status = success) -> X(((system.getTarget.status = success) | (system.getTarget.status = failure)))));
LTLSPEC G(((system.followHuman.status = success) -> X(((system.getTarget.status = success) | (system.getTarget.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
