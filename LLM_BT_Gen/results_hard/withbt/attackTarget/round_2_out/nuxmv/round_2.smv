    VAR
        node_names : define_nodes;
        getTarget : success_DEFAULT_module();
        goToPosA : success_DEFAULT_module();
        TargetAdjacent : TargetAdjacent_module(TargetAdjacent_v_stage_0);
        attackTarget : success_DEFAULT_module();
        c1 : composite_sequence_without_memory_4(getTarget, goToPosA, TargetAdjacent, attackTarget);
        isHungry : isHungry_module(isHungry_v_stage_0);
        findFood : success_DEFAULT_module();
        goToPosB : success_DEFAULT_module();
        findTableware : success_DEFAULT_module();
        eatfood : success_DEFAULT_module();
        c3 : composite_sequence_without_memory_5(isHungry, findFood, goToPosB, findTableware, eatfood);
        followHuman : success_DEFAULT_module();
        c2 : composite_selector_without_memory_2(c3, followHuman);
        c0 : composite_selector_without_memory_2(c1, c2);
