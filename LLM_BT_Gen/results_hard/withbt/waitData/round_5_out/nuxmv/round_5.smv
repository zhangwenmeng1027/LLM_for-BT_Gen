MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.isDay.status = success) | (system.isDay.status = failure)));
LTLSPEC G(((system.isDay.status = success) -> X(((system.hasInput.status = success) | (system.hasInput.status = failure)))));
LTLSPEC G(((system.isDay.status = failure) -> X(((system.isNight.status = success) | (system.isNight.status = failure)))));
LTLSPEC G(((system.hasInput.status = success) -> X(((system.searchAns.status = success) | (system.searchAns.status = failure) | (system.searchAns.status = running)))));
LTLSPEC G(((system.hasInput.status = failure) -> X(((system.waitInput.status = success) | (system.waitInput.status = failure) | (system.waitInput.status = running)))));
LTLSPEC G(((system.waitInput.status = success) -> X(((system.searchAns.status = success) | (system.searchAns.status = failure) | (system.searchAns.status = running)))));
LTLSPEC G(((system.searchAns.status = success) -> X(((system.isDay.status = success) | (system.isDay.status = failure)))));
LTLSPEC G(((system.isNight.status = success) -> X(((system.atCharge.status = success) | (system.atCharge.status = failure)))));
LTLSPEC G(((system.isNight.status = failure) -> X(((system.fullBattery.status = success) | (system.fullBattery.status = failure)))));
LTLSPEC G(((system.atCharge.status = success) -> X(((system.charging.status = success) | (system.charging.status = failure) | (system.charging.status = running)))));
LTLSPEC G(((system.atCharge.status = failure) -> X(((system.goToStation.status = success) | (system.goToStation.status = failure) | (system.goToStation.status = running)))));
LTLSPEC G(((system.goToStation.status = success) -> X(((system.charging.status = success) | (system.charging.status = failure) | (system.charging.status = running)))));
LTLSPEC G(((system.charging.status = success) -> X(((system.isDay.status = success) | (system.isDay.status = failure)))));
LTLSPEC G(((system.fullBattery.status = success) -> X(((system.getTarget.status = success) | (system.getTarget.status = failure) | (system.getTarget.status = running)))));
LTLSPEC G(((system.fullBattery.status = failure) -> X(((system.isDay.status = success) | (system.isDay.status = failure)))));
LTLSPEC G(((system.getTarget.status = success) -> X(((system.searchTarget.status = success) | (system.searchTarget.status = failure) | (system.searchTarget.status = running)))));
LTLSPEC G(((system.searchTarget.status = success) -> X(((system.isDay.status = success) | (system.isDay.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        isDay : isDay_module(isDay_v_stage_0);
        hasInput : hasInput_module(hasInput_v_stage_0);
        waitInput : success_DEFAULT_module();
        c2 : composite_selector_without_memory_2(hasInput, waitInput);
        searchAns : success_DEFAULT_module();
        c1 : composite_sequence_without_memory_3(isDay, c2, searchAns);
        isNight : isNight_module(isNight_v_stage_0);
        atCharge : atCharge_module(atCharge_v_stage_0);
        goToStation : success_DEFAULT_module();
        c4 : composite_selector_without_memory_2(atCharge, goToStation);
        charging : success_DEFAULT_module();
        c3 : composite_sequence_without_memory_3(isNight, c4, charging);
        fullBattery : fullBattery_module(fullBattery_v_stage_0);
        getTarget : success_DEFAULT_module();
        searchTarget : success_DEFAULT_module();
        c5 : composite_sequence_without_memory_3(fullBattery, getTarget, searchTarget);
        c0 : composite_selector_without_memory_3(c1, c3, c5);
        --START OF BLACKBOARD VARIABLES DECLARATION
        isDay_v_stage_0 : boolean;
        hasInput_v_stage_0 : boolean;
        isNight_v_stage_0 : boolean;
        atCharge_v_stage_0 : boolean;
        fullBattery_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(isDay_v_stage_0) := {TRUE, FALSE};
        init(hasInput_v_stage_0) := {TRUE, FALSE};
        init(isNight_v_stage_0) := {TRUE, FALSE};
        init(atCharge_v_stage_0) := {TRUE, FALSE};
        init(fullBattery_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(isDay_v_stage_0) :=
            case
                !(c0.active) : isDay_v_stage_0;
                TRUE : isDay_v_stage_0;
            esac;
        next(hasInput_v_stage_0) :=
            case
                !(c0.active) : hasInput_v_stage_0;
                TRUE : hasInput_v_stage_0;
            esac;
        next(isNight_v_stage_0) :=
            case
                !(c0.active) : isNight_v_stage_0;
                TRUE : isNight_v_stage_0;
            esac;
        next(atCharge_v_stage_0) :=
            case
                !(c0.active) : atCharge_v_stage_0;
                TRUE : atCharge_v_stage_0;
            esac;
        next(fullBattery_v_stage_0) :=
            case
                !(c0.active) : fullBattery_v_stage_0;
                TRUE : fullBattery_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        c1 := 1;
        isDay := 2;
        c2 := 3;
        hasInput := 4;
        waitInput := 5;
        searchAns := 6;
        c3 := 7;
