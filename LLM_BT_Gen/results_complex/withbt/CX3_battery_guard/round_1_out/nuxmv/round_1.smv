        stopCharge : success_DEFAULT_module();
        goToPosB_2 : success_DEFAULT_module();
        doTaskB_2 : success_DEFAULT_module();
        c4 : composite_sequence_without_memory_4(isCharge, stopCharge, goToPosB_2, doTaskB_2);
        c0 : composite_selector_without_memory_3(c1, c2, c4);
