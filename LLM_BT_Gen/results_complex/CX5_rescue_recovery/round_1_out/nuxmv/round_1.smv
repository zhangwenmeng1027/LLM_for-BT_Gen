        askHelp : success_DEFAULT_module();
        c1 : composite_selector_without_memory_2(checkReachable, askHelp);
        goToPosC : success_DEFAULT_module();
        saveVictim : success_DEFAULT_module();
        placed : placed_module(placed_v_stage_0);
