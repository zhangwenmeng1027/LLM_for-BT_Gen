MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.picked.status = success) | (system.picked.status = failure)));
LTLSPEC G(((system.picked.status = failure) -> X(((system.atPosA.status = success) | (system.atPosA.status = failure)))));
LTLSPEC G(((system.atPosA.status = success) -> X((((system.pickUp.status = success) | (system.pickUp_2.status = success)) | ((system.pickUp.status = failure) | (system.pickUp_2.status = failure)) | ((system.pickUp.status = running) | (system.pickUp_2.status = running))))));
LTLSPEC G(((system.atPosA.status = failure) -> X(((system.goToPosA.status = success) | (system.goToPosA.status = failure) | (system.goToPosA.status = running)))));
LTLSPEC G(((system.goToPosA.status = success) -> X((((system.pickUp.status = success) | (system.pickUp_2.status = success)) | ((system.pickUp.status = failure) | (system.pickUp_2.status = failure)) | ((system.pickUp.status = running) | (system.pickUp_2.status = running))))));
LTLSPEC G(((system.placed.status = failure) -> X(((system.atPosB.status = success) | (system.atPosB.status = failure)))));
LTLSPEC G(((system.atPosB.status = success) -> X((((system.putDown.status = success) | (system.putDown_2.status = success)) | ((system.putDown.status = failure) | (system.putDown_2.status = failure)) | ((system.putDown.status = running) | (system.putDown_2.status = running))))));
LTLSPEC G(((system.atPosB.status = failure) -> X(((system.goToPosB.status = success) | (system.goToPosB.status = failure) | (system.goToPosB.status = running)))));
LTLSPEC G(((system.goToPosB.status = success) -> X((((system.putDown.status = success) | (system.putDown_2.status = success)) | ((system.putDown.status = failure) | (system.putDown_2.status = failure)) | ((system.putDown.status = running) | (system.putDown_2.status = running))))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        picked : picked_module(picked_v_stage_0);
        atPosA : atPosA_module(atPosA_v_stage_0);
        pickUp : success_DEFAULT_module();
        c2 : composite_sequence_without_memory_2(atPosA, pickUp);
        goToPosA : success_DEFAULT_module();
        pickUp_2 : success_DEFAULT_module();
        c3 : composite_sequence_without_memory_2(goToPosA, pickUp_2);
        c1 : composite_selector_without_memory_3(picked, c2, c3);
        placed : placed_module(placed_v_stage_0);
        atPosB : atPosB_module(atPosB_v_stage_0);
        putDown : success_DEFAULT_module();
        c5 : composite_sequence_without_memory_2(atPosB, putDown);
        goToPosB : success_DEFAULT_module();
        putDown_2 : success_DEFAULT_module();
        c6 : composite_sequence_without_memory_2(goToPosB, putDown_2);
        c4 : composite_selector_without_memory_3(placed, c5, c6);
        c0 : composite_sequence_without_memory_2(c1, c4);
        --START OF BLACKBOARD VARIABLES DECLARATION
        picked_v_stage_0 : boolean;
        atPosA_v_stage_0 : boolean;
        placed_v_stage_0 : boolean;
        atPosB_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(picked_v_stage_0) := {TRUE, FALSE};
        init(atPosA_v_stage_0) := {TRUE, FALSE};
        init(placed_v_stage_0) := {TRUE, FALSE};
        init(atPosB_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(picked_v_stage_0) :=
            case
                !(c0.active) : picked_v_stage_0;
                TRUE : picked_v_stage_0;
            esac;
        next(atPosA_v_stage_0) :=
            case
                !(c0.active) : atPosA_v_stage_0;
                TRUE : atPosA_v_stage_0;
            esac;
        next(placed_v_stage_0) :=
            case
                !(c0.active) : placed_v_stage_0;
                TRUE : placed_v_stage_0;
            esac;
        next(atPosB_v_stage_0) :=
            case
                !(c0.active) : atPosB_v_stage_0;
                TRUE : atPosB_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        c1 := 1;
        picked := 2;
        c2 := 3;
        atPosA := 4;
        pickUp := 5;
        c3 := 6;
        goToPosA := 7;
        pickUp_2 := 8;
        c4 := 9;
        placed := 10;
        c5 := 11;
        atPosB := 12;
        putDown := 13;
        c6 := 14;
        goToPosB := 15;
        putDown_2 := 16;
MODULE composite_selector_without_memory_3(child_0, child_1, child_2)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = failure) : child_0.internal_status;
                !(child_1.internal_status = failure) : child_1.internal_status;
                !(child_2.internal_status = failure) : child_2.internal_status;
                TRUE : failure;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = failure;
        child_2.active := child_1.status = failure;
MODULE composite_sequence_without_memory_2(child_0, child_1)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
MODULE picked_module(picked_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (picked_v_stage_0) ? success : failure;
MODULE atPosA_module(atPosA_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (atPosA_v_stage_0) ? success : failure;
MODULE placed_module(placed_v_stage_0)
