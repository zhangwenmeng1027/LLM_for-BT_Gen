LTLSPEC G(((system.move1to2.status = success) -> X((((system.activeManipulator.status = success) | (system.activeManipulator_2.status = success) | (system.activeManipulator_3.status = success) | (system.activeManipulator_4.status = success)) | ((system.activeManipulator.status = failure) | (system.activeManipulator_2.status = failure) | (system.activeManipulator_3.status = failure) | (system.activeManipulator_4.status = failure)) | ((system.activeManipulator.status = running) | (system.activeManipulator_2.status = running) | (system.activeManipulator_3.status = running) | (system.activeManipulator_4.status = running))))));
LTLSPEC G(((system.move2to3.status = success) -> X((((system.activeManipulator.status = success) | (system.activeManipulator_2.status = success) | (system.activeManipulator_3.status = success) | (system.activeManipulator_4.status = success)) | ((system.activeManipulator.status = failure) | (system.activeManipulator_2.status = failure) | (system.activeManipulator_3.status = failure) | (system.activeManipulator_4.status = failure)) | ((system.activeManipulator.status = running) | (system.activeManipulator_2.status = running) | (system.activeManipulator_3.status = running) | (system.activeManipulator_4.status = running))))));
LTLSPEC G(((system.move3to4.status = success) -> X((((system.activeManipulator.status = success) | (system.activeManipulator_2.status = success) | (system.activeManipulator_3.status = success) | (system.activeManipulator_4.status = success)) | ((system.activeManipulator.status = failure) | (system.activeManipulator_2.status = failure) | (system.activeManipulator_3.status = failure) | (system.activeManipulator_4.status = failure)) | ((system.activeManipulator.status = running) | (system.activeManipulator_2.status = running) | (system.activeManipulator_3.status = running) | (system.activeManipulator_4.status = running))))));
LTLSPEC G(((system.move4to5.status = success) -> X((((system.activeManipulator.status = success) | (system.activeManipulator_2.status = success) | (system.activeManipulator_3.status = success) | (system.activeManipulator_4.status = success)) | ((system.activeManipulator.status = failure) | (system.activeManipulator_2.status = failure) | (system.activeManipulator_3.status = failure) | (system.activeManipulator_4.status = failure)) | ((system.activeManipulator.status = running) | (system.activeManipulator_2.status = running) | (system.activeManipulator_3.status = running) | (system.activeManipulator_4.status = running))))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        move1to2 : success_DEFAULT_module();
        activeManipulator : success_DEFAULT_module();
        c1 : composite_sequence_without_memory_2(move1to2, activeManipulator);
        move2to3 : success_DEFAULT_module();
        activeManipulator_2 : success_DEFAULT_module();
        c2 : composite_sequence_without_memory_2(move2to3, activeManipulator_2);
        move3to4 : success_DEFAULT_module();
        activeManipulator_3 : success_DEFAULT_module();
        c3 : composite_sequence_without_memory_2(move3to4, activeManipulator_3);
        move4to5 : success_DEFAULT_module();
        activeManipulator_4 : success_DEFAULT_module();
        c4 : composite_sequence_without_memory_2(move4to5, activeManipulator_4);
        c0 : composite_sequence_without_memory_4(c1, c2, c3, c4);
        --START OF BLACKBOARD VARIABLES DECLARATION
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        c1 := 1;
        move1to2 := 2;
        activeManipulator := 3;
        c2 := 4;
        move2to3 := 5;
        activeManipulator_2 := 6;
        c3 := 7;
        move3to4 := 8;
        activeManipulator_3 := 9;
        c4 := 10;
        move4to5 := 11;
        activeManipulator_4 := 12;
MODULE composite_sequence_without_memory_2(child_0, child_1)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
MODULE composite_sequence_without_memory_4(child_0, child_1, child_2, child_3)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                !(child_2.internal_status = success) : child_2.internal_status;
                !(child_3.internal_status = success) : child_3.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
        child_2.active := child_1.status = success;
        child_3.active := child_2.status = success;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
