MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.openGripper.status = success) | (system.openGripper.status = failure) | (system.openGripper.status = running)));
LTLSPEC G(((system.openGripper.status = success) -> X(((system.moveFingerToTargetPosition.status = success) | (system.moveFingerToTargetPosition.status = failure) | (system.moveFingerToTargetPosition.status = running)))));
LTLSPEC G(((system.moveFingerToTargetPosition.status = success) -> X(((system.closeGripper.status = success) | (system.closeGripper.status = failure) | (system.closeGripper.status = running)))));
LTLSPEC G(((system.closeGripper.status = success) -> X(((system.goToPosA.status = success) | (system.goToPosA.status = failure) | (system.goToPosA.status = running)))));
LTLSPEC G(((system.goToPosA.status = success) -> X(((system.putDown.status = success) | (system.putDown.status = failure) | (system.putDown.status = running)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        openGripper : success_DEFAULT_module();
        moveFingerToTargetPosition : success_DEFAULT_module();
        closeGripper : success_DEFAULT_module();
        goToPosA : success_DEFAULT_module();
        putDown : success_DEFAULT_module();
        c0 : composite_sequence_without_memory_5(openGripper, moveFingerToTargetPosition, closeGripper, goToPosA, putDown);
        --START OF BLACKBOARD VARIABLES DECLARATION
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        openGripper := 1;
        moveFingerToTargetPosition := 2;
        closeGripper := 3;
        goToPosA := 4;
        putDown := 5;
MODULE composite_sequence_without_memory_5(child_0, child_1, child_2, child_3, child_4)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                !(child_2.internal_status = success) : child_2.internal_status;
                !(child_3.internal_status = success) : child_3.internal_status;
                !(child_4.internal_status = success) : child_4.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
        child_2.active := child_1.status = success;
        child_3.active := child_2.status = success;
        child_4.active := child_3.status = success;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
