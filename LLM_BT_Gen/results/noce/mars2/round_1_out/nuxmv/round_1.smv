MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.haveData.status = success) | (system.haveData.status = failure)));
LTLSPEC G(((system.haveData.status = failure) -> X(((system.hasSample.status = success) | (system.hasSample.status = failure)))));
LTLSPEC G(((system.hasSample.status = success) -> X((((system.analyze.status = success) | (system.analyze_2.status = success)) | ((system.analyze.status = failure) | (system.analyze_2.status = failure)) | ((system.analyze.status = running) | (system.analyze_2.status = running))))));
LTLSPEC G(((system.holdItem.status = failure) -> X(((system.pickUp.status = success) | (system.pickUp.status = failure) | (system.pickUp.status = running)))));
LTLSPEC G(((system.pickUp.status = success) -> X(((system.atStation.status = success) | (system.atStation.status = failure)))));
LTLSPEC G(((system.atStation.status = failure) -> X(((system.goToStation.status = success) | (system.goToStation.status = failure) | (system.goToStation.status = running)))));
LTLSPEC G(((system.putDown.status = success) -> X((((system.analyze.status = success) | (system.analyze_2.status = success)) | ((system.analyze.status = failure) | (system.analyze_2.status = failure)) | ((system.analyze.status = running) | (system.analyze_2.status = running))))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        haveData : haveData_module(haveData_v_stage_0);
        analyze : success_DEFAULT_module();
        c1 : composite_sequence_without_memory_2(haveData, analyze);
        hasSample : hasSample_module(hasSample_v_stage_0);
        analyze_2 : success_DEFAULT_module();
        c3 : composite_sequence_without_memory_2(hasSample, analyze_2);
        holdItem : holdItem_module(holdItem_v_stage_0);
        pickUp : success_DEFAULT_module();
        c5 : composite_selector_without_memory_2(holdItem, pickUp);
        atStation : atStation_module(atStation_v_stage_0);
        goToStation : success_DEFAULT_module();
        c6 : composite_selector_without_memory_2(atStation, goToStation);
        putDown : success_DEFAULT_module();
        c4 : composite_sequence_without_memory_3(c5, c6, putDown);
        c2 : composite_selector_without_memory_2(c3, c4);
        c0 : composite_selector_without_memory_2(c1, c2);
        --START OF BLACKBOARD VARIABLES DECLARATION
        haveData_v_stage_0 : boolean;
        hasSample_v_stage_0 : boolean;
        holdItem_v_stage_0 : boolean;
        atStation_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(haveData_v_stage_0) := {TRUE, FALSE};
        init(hasSample_v_stage_0) := {TRUE, FALSE};
        init(holdItem_v_stage_0) := {TRUE, FALSE};
        init(atStation_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(haveData_v_stage_0) :=
            case
                !(c0.active) : haveData_v_stage_0;
                TRUE : haveData_v_stage_0;
            esac;
        next(hasSample_v_stage_0) :=
            case
                !(c0.active) : hasSample_v_stage_0;
                TRUE : hasSample_v_stage_0;
            esac;
        next(holdItem_v_stage_0) :=
            case
                !(c0.active) : holdItem_v_stage_0;
                TRUE : holdItem_v_stage_0;
            esac;
        next(atStation_v_stage_0) :=
            case
                !(c0.active) : atStation_v_stage_0;
                TRUE : atStation_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        c1 := 1;
        haveData := 2;
        analyze := 3;
        c2 := 4;
        c3 := 5;
        hasSample := 6;
