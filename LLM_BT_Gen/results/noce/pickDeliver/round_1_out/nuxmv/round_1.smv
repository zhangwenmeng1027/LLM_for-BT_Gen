MODULE noDeliverTask_module(noDeliverTask_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (noDeliverTask_v_stage_0) ? success : failure;
MODULE _DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := invalid;
        internal_status := invalid;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
