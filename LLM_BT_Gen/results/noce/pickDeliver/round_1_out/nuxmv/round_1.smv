MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.moveDefaultDeliverPos.status = success) | (system.moveDefaultDeliverPos.status = failure) | (system.moveDefaultDeliverPos.status = running)));
LTLSPEC G(((system.moveDefaultDeliverPos.status = success) -> X((((system.deliverObj.status = success) | (system.deliverObj_2.status = success)) | ((system.deliverObj.status = failure) | (system.deliverObj_2.status = failure)) | ((system.deliverObj.status = running) | (system.deliverObj_2.status = running))))));
LTLSPEC G(((system.moveDefaultDeliverPos.status = failure) -> X(((system.moveDesignPos.status = success) | (system.moveDesignPos.status = failure) | (system.moveDesignPos.status = running)))));
LTLSPEC G(((system.moveDesignPos.status = success) -> X((((system.deliverObj.status = success) | (system.deliverObj_2.status = success)) | ((system.deliverObj.status = failure) | (system.deliverObj_2.status = failure)) | ((system.deliverObj.status = running) | (system.deliverObj_2.status = running))))));
LTLSPEC G(((system.noDeliverTask.status = success) -> X(((system.goToStation.status = success) | (system.goToStation.status = failure) | (system.goToStation.status = running)))));
LTLSPEC G(((system.goToStation.status = success) -> X(((system.charging.status = success) | (system.charging.status = failure) | (system.charging.status = running)))));
LTLSPEC G(((system.approachTarget.status = success) -> X(((system.detectObj.status = success) | (system.detectObj.status = failure) | (system.detectObj.status = running)))));
LTLSPEC G(((system.detectObj.status = success) -> X(((system.pickUp.status = success) | (system.pickUp.status = failure) | (system.pickUp.status = running)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        moveDefaultDeliverPos : success_DEFAULT_module();
        deliverObj : success_DEFAULT_module();
        c2 : composite_sequence_without_memory_2(moveDefaultDeliverPos, deliverObj);
        moveDesignPos : _DEFAULT_module();
        deliverObj_2 : _DEFAULT_module();
        c3 : composite_sequence_without_memory_2(moveDesignPos, deliverObj_2);
        c1 : composite_selector_without_memory_2(c2, c3);
        noDeliverTask : noDeliverTask_module(noDeliverTask_v_stage_0);
        goToStation : _DEFAULT_module();
        charging : _DEFAULT_module();
        c4 : composite_sequence_without_memory_3(noDeliverTask, goToStation, charging);
        approachTarget : _DEFAULT_module();
        detectObj : _DEFAULT_module();
        pickUp : _DEFAULT_module();
        c5 : composite_sequence_without_memory_3(approachTarget, detectObj, pickUp);
        c0 : composite_selector_without_memory_3(c1, c4, c5);
        --START OF BLACKBOARD VARIABLES DECLARATION
        noDeliverTask_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(noDeliverTask_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(noDeliverTask_v_stage_0) :=
            case
                !(c0.active) : noDeliverTask_v_stage_0;
                TRUE : noDeliverTask_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        c1 := 1;
        c2 := 2;
        moveDefaultDeliverPos := 3;
        deliverObj := 4;
        c3 := 5;
        moveDesignPos := 6;
        deliverObj_2 := 7;
        c4 := 8;
        noDeliverTask := 9;
        goToStation := 10;
        charging := 11;
        c5 := 12;
        approachTarget := 13;
        detectObj := 14;
        pickUp := 15;
MODULE composite_sequence_without_memory_3(child_0, child_1, child_2)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                !(child_2.internal_status = success) : child_2.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
        child_2.active := child_1.status = success;
MODULE composite_sequence_without_memory_2(child_0, child_1)
    CONSTANTS
