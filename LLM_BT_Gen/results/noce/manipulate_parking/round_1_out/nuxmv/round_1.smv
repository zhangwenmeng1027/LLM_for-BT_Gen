MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.moveToPanel.status = success) | (system.moveToPanel.status = failure) | (system.moveToPanel.status = running)));
LTLSPEC G(((system.moveToPanel.status = success) -> X(((system.moveFingerToTargetPosition.status = success) | (system.moveFingerToTargetPosition.status = failure) | (system.moveFingerToTargetPosition.status = running)))));
LTLSPEC G(((system.moveFingerToTargetPosition.status = success) -> X(((system.followOperation.status = success) | (system.followOperation.status = failure) | (system.followOperation.status = running)))));
LTLSPEC G(((system.followOperation.status = success) -> X(((system.moveToParking.status = success) | (system.moveToParking.status = failure) | (system.moveToParking.status = running)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        moveToPanel : success_DEFAULT_module();
        moveFingerToTargetPosition : success_DEFAULT_module();
        followOperation : success_DEFAULT_module();
        moveToParking : success_DEFAULT_module();
        c0 : composite_sequence_without_memory_4(moveToPanel, moveFingerToTargetPosition, followOperation, moveToParking);
        --START OF BLACKBOARD VARIABLES DECLARATION
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        moveToPanel := 1;
        moveFingerToTargetPosition := 2;
        followOperation := 3;
        moveToParking := 4;
MODULE composite_sequence_without_memory_4(child_0, child_1, child_2, child_3)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                !(child_2.internal_status = success) : child_2.internal_status;
                !(child_3.internal_status = success) : child_3.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
        child_2.active := child_1.status = success;
        child_3.active := child_2.status = success;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
