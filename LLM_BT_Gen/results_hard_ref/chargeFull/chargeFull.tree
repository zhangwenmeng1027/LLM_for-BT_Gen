    LTLSPEC {(globally, (implies, (success, stopCharge), (next, (or, (success, fullBattery), (failure, fullBattery)))))}
    LTLSPEC {(globally, (implies, (success, lowBattery), (next, (or, (success, connectToStation), (failure, connectToStation), (running, connectToStation)))))}
    LTLSPEC {(globally, (implies, (failure, lowBattery), (next, (or, (success, askHelp), (failure, askHelp), (running, askHelp)))))}
    LTLSPEC {(globally, (implies, (success, connectToStation), (next, (or, (success, charging), (failure, charging), (running, charging)))))}
