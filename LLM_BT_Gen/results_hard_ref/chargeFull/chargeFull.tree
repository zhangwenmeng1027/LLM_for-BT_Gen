    LTLSPEC {(globally, (implies, (success, fullBattery), (next, (or, (success, isCharge), (failure, isCharge)))))}
    LTLSPEC {(globally, (implies, (failure, fullBattery), (next, (or, (success, lowBattery), (failure, lowBattery)))))}
