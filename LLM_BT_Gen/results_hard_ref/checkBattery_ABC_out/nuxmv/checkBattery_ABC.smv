LTLSPEC G(((system.goToPosB.status = success) -> X(((system.putDown.status = success) | (system.putDown.status = failure) | (system.putDown.status = running)))));
LTLSPEC G(((system.putDown.status = success) -> X(((system.goToPosC.status = success) | (system.goToPosC.status = failure) | (system.goToPosC.status = running)))));
LTLSPEC G(((system.goToPosC.status = success) -> X(((system.doTaskC.status = success) | (system.doTaskC.status = failure) | (system.doTaskC.status = running)))));
LTLSPEC G(((system.doTaskC.status = success) -> X(((system.goToPosA.status = success) | (system.goToPosA.status = failure)))));
LTLSPEC G(((system.lowBattery.status = success) -> X(((system.goToStation.status = success) | (system.goToStation.status = failure) | (system.goToStation.status = running)))));
