LTLSPEC G(((system.charging.status = success) -> X(((system.isHungry.status = success) | (system.isHungry.status = failure)))));
LTLSPEC G(((system.isHungry.status = success) -> X(((system.eatfood.status = success) | (system.eatfood.status = failure) | (system.eatfood.status = running)))));
LTLSPEC G(((system.isHungry.status = failure) -> X(((system.followHuman.status = success) | (system.followHuman.status = failure) | (system.followHuman.status = running)))));
LTLSPEC G(((system.eatfood.status = success) -> X(((system.goToPosA.status = success) | (system.goToPosA.status = failure)))));
LTLSPEC G(((system.followHuman.status = success) -> X(((system.goToPosA.status = success) | (system.goToPosA.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        goToPosA : success_DEFAULT_module();
        pickUp : success_DEFAULT_module();
        checkBattery : success_DEFAULT_module();
        doTaskA : success_DEFAULT_module();
        c1 : composite_sequence_without_memory_4(goToPosA, pickUp, checkBattery, doTaskA);
        atPosA : atPosA_module(atPosA_v_stage_0);
        empty : empty_module(empty_v_stage_0);
        c3 : composite_sequence_without_memory_2(atPosA, empty);
        pickUp_2 : _DEFAULT_module();
        goToPosB : _DEFAULT_module();
        putDown : _DEFAULT_module();
        goToPosC : _DEFAULT_module();
        doTaskC : _DEFAULT_module();
        c2 : composite_sequence_without_memory_6(c3, pickUp_2, goToPosB, putDown, goToPosC, doTaskC);
        lowBattery : lowBattery_module(lowBattery_v_stage_0);
        goToStation : _DEFAULT_module();
        charging : _DEFAULT_module();
        c5 : composite_sequence_without_memory_3(lowBattery, goToStation, charging);
        isHungry : isHungry_module(isHungry_v_stage_0);
        eatfood : _DEFAULT_module();
        c6 : composite_sequence_without_memory_2(isHungry, eatfood);
        c4 : composite_sequence_without_memory_2(c5, c6);
        followHuman : _DEFAULT_module();
        c0 : composite_selector_without_memory_4(c1, c2, c4, followHuman);
        --START OF BLACKBOARD VARIABLES DECLARATION
        atPosA_v_stage_0 : boolean;
        empty_v_stage_0 : boolean;
        lowBattery_v_stage_0 : boolean;
        isHungry_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(atPosA_v_stage_0) := {TRUE, FALSE};
        init(empty_v_stage_0) := {TRUE, FALSE};
        init(lowBattery_v_stage_0) := {TRUE, FALSE};
        init(isHungry_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(atPosA_v_stage_0) :=
            case
                !(c0.active) : atPosA_v_stage_0;
                TRUE : atPosA_v_stage_0;
            esac;
        next(empty_v_stage_0) :=
            case
                !(c0.active) : empty_v_stage_0;
                TRUE : empty_v_stage_0;
            esac;
        next(lowBattery_v_stage_0) :=
            case
                !(c0.active) : lowBattery_v_stage_0;
                TRUE : lowBattery_v_stage_0;
            esac;
        next(isHungry_v_stage_0) :=
            case
                !(c0.active) : isHungry_v_stage_0;
                TRUE : isHungry_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

