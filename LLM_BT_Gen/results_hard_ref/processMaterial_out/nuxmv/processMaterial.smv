MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.pushR.status = success) | (system.pushR.status = failure)));
LTLSPEC G(((system.pushR.status = success) -> X(((system.acceptedMaterial.status = success) | (system.acceptedMaterial.status = failure)))));
LTLSPEC G(((system.acceptedMaterial.status = success) -> X(((system.pushP.status = success) | (system.pushP.status = failure) | (system.pushP.status = running)))));
LTLSPEC G(((system.acceptedMaterial.status = failure) -> X(((system.pushR.status = success) | (system.pushR.status = failure)))));
LTLSPEC G(((system.pushP.status = success) -> X(((system.isProcessed.status = success) | (system.isProcessed.status = failure)))));
LTLSPEC G(((system.isProcessed.status = success) -> X(((system.pushC.status = success) | (system.pushC.status = failure) | (system.pushC.status = running)))));
LTLSPEC G(((system.isProcessed.status = failure) -> X(((system.pushR.status = success) | (system.pushR.status = failure)))));
LTLSPEC G(((system.pushC.status = success) -> X(((system.pushR.status = success) | (system.pushR.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        pushR : success_DEFAULT_module();
        acceptedMaterial : acceptedMaterial_module(acceptedMaterial_v_stage_0);
        pushP : success_DEFAULT_module();
        c1 : composite_sequence_without_memory_2(acceptedMaterial, pushP);
        isProcessed : isProcessed_module(isProcessed_v_stage_0);
        pushC : success_DEFAULT_module();
        c2 : composite_sequence_without_memory_2(isProcessed, pushC);
        c0 : composite_sequence_without_memory_3(pushR, c1, c2);
        --START OF BLACKBOARD VARIABLES DECLARATION
        acceptedMaterial_v_stage_0 : boolean;
        isProcessed_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(acceptedMaterial_v_stage_0) := {TRUE, FALSE};
        init(isProcessed_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(acceptedMaterial_v_stage_0) :=
            case
                !(c0.active) : acceptedMaterial_v_stage_0;
                TRUE : acceptedMaterial_v_stage_0;
            esac;
        next(isProcessed_v_stage_0) :=
            case
                !(c0.active) : isProcessed_v_stage_0;
                TRUE : isProcessed_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        pushR := 1;
        c1 := 2;
        acceptedMaterial := 3;
        pushP := 4;
        c2 := 5;
        isProcessed := 6;
        pushC := 7;
MODULE composite_sequence_without_memory_3(child_0, child_1, child_2)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                !(child_2.internal_status = success) : child_2.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
        child_2.active := child_1.status = success;
MODULE composite_sequence_without_memory_2(child_0, child_1)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
MODULE acceptedMaterial_module(acceptedMaterial_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (acceptedMaterial_v_stage_0) ? success : failure;
MODULE isProcessed_module(isProcessed_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (isProcessed_v_stage_0) ? success : failure;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
