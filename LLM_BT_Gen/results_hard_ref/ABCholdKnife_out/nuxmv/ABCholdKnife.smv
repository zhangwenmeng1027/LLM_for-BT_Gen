MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC X(((system.doTaskA.status = success) | (system.doTaskA.status = failure)));
LTLSPEC G(((system.doTaskA.status = success) -> X(((system.goToKitchen.status = success) | (system.goToKitchen.status = failure) | (system.goToKitchen.status = running)))));
LTLSPEC G(((system.doTaskB.status = success) -> X(((system.goToKitchen.status = success) | (system.goToKitchen.status = failure) | (system.goToKitchen.status = running)))));
LTLSPEC G(((system.goToKitchen.status = success) -> X(((system.holdKnife.status = success) | (system.holdKnife.status = failure)))));
LTLSPEC G(((system.holdKnife.status = success) -> X(((system.doTaskC.status = success) | (system.doTaskC.status = failure) | (system.doTaskC.status = running)))));
LTLSPEC G(((system.holdKnife.status = failure) -> X(((system.doTaskA.status = success) | (system.doTaskA.status = failure)))));
LTLSPEC G(((system.doTaskC.status = success) -> X(((system.doTaskA.status = success) | (system.doTaskA.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        resume_from_here_in_subtree__c0 := -3;
        c0.active := TRUE;
        --START OF BLACKBOARD DEFINITIONS
        --END OF BLACKBOARD DEFINITIONS
    VAR
        node_names : define_nodes;
        doTaskA : success_DEFAULT_module();
        doTaskB : _DEFAULT_module();
        c1 : composite_selector_without_memory_2(doTaskA, doTaskB);
        goToKitchen : success_DEFAULT_module();
        holdKnife : holdKnife_module(holdKnife_v_stage_0);
        doTaskC : success_DEFAULT_module();
        c2 : composite_sequence_without_memory_2(holdKnife, doTaskC);
        c0 : composite_sequence_without_memory_3(c1, goToKitchen, c2);
        --START OF BLACKBOARD VARIABLES DECLARATION
        holdKnife_v_stage_0 : boolean;
        --END OF BLACKBOARD VARIABLES DECLARATION
    ASSIGN
        --START OF BLACKBOARD VARIABLES INITIALIZATION
        init(holdKnife_v_stage_0) := {TRUE, FALSE};
        --END OF BLACKBOARD VARIABLES INITIALIZATION
        --START OF BLACKBOARD VARIABLES TRANSITION
        next(holdKnife_v_stage_0) :=
            case
                !(c0.active) : holdKnife_v_stage_0;
                TRUE : holdKnife_v_stage_0;
            esac;
        --END OF BLACKBOARD VARIABLES TRANSITION

MODULE define_nodes
    DEFINE
        c0 := 0;
        c1 := 1;
        doTaskA := 2;
        doTaskB := 3;
        goToKitchen := 4;
        c2 := 5;
        holdKnife := 6;
        doTaskC := 7;
MODULE composite_selector_without_memory_2(child_0, child_1)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = failure) : child_0.internal_status;
                !(child_1.internal_status = failure) : child_1.internal_status;
                TRUE : failure;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = failure;
MODULE composite_sequence_without_memory_2(child_0, child_1)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
MODULE composite_sequence_without_memory_3(child_0, child_1, child_2)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status :=
            case
                !(child_0.internal_status = success) : child_0.internal_status;
                !(child_1.internal_status = success) : child_1.internal_status;
                !(child_2.internal_status = success) : child_2.internal_status;
                TRUE : success;
            esac;
        child_0.active := active;
        child_1.active := child_0.status = success;
        child_2.active := child_1.status = success;
MODULE holdKnife_module(holdKnife_v_stage_0)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := (holdKnife_v_stage_0) ? success : failure;
MODULE _DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := invalid;
        internal_status := invalid;
MODULE success_DEFAULT_module
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status := active ? internal_status : invalid;
        internal_status := success;
