LTLSPEC G(((system.atPosC.status = failure) -> X(((system.atKitchen.status = success) | (system.atKitchen.status = failure)))));
LTLSPEC G(((system.doTaskA.status = success) -> X(((system.atPosA.status = success) | (system.atPosA.status = failure)))));
LTLSPEC G(((system.atKitchen.status = success) -> X(((system.locateBottle.status = success) | (system.locateBottle.status = failure) | (system.locateBottle.status = running)))));
LTLSPEC G(((system.atKitchen.status = failure) -> X(((system.atPosA.status = success) | (system.atPosA.status = failure)))));
LTLSPEC G(((system.locateBottle.status = success) -> X(((system.atPosA.status = success) | (system.atPosA.status = failure)))));

--------------END OF SPECIFICATIONS

MODULE system_module
    CONSTANTS
        success, failure, running, invalid;
