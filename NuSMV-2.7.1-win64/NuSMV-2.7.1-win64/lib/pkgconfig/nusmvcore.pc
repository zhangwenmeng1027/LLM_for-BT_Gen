prefix=C:/msys64
includedir=${prefix}/include
libdir=${prefix}/lib

with_bignumbers=true
with_compass=true
with_libxml2=true
with_ltl2smv=true
with_profiler=false
with_shell=true
with_watchdog=false

Name: nusmvcore
Description: NuSMV core library
Version: 2.7.1
Requires: cudd, minisat, gmp, gnurx, libxml-2.0
Libs: -L${libdir} -lnusmvcore
Cflags: -I${includedir}
