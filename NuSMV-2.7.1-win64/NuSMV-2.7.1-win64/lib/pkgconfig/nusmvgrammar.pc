prefix=C:/msys64
includedir=${prefix}/include
libdir=${prefix}/lib

with_bignumbers=true
with_compass=true
with_libxml2=true
with_ltl2smv=true
with_profiler=false
with_shell=true
with_watchdog=false

Name: nusmvgrammar
Description: NuSMV grammar library
Version: 2.7.1
Requires: cudd
Libs: -L${libdir} -lnusmvgrammar
Cflags: -I${includedir}
