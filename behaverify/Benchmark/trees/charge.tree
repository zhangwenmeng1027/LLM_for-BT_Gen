configuration {} enumerations {} constants {}
variables {
    variable { env lowBattery_v VAR BOOLEAN assign{result{True, False}} }
    variable { env atCharge_v VAR BOOLEAN assign{result{True, False}} }
}
environment_update {
    variable_statement{ lowBattery_v assign{result{lowBattery_v}} }
    variable_statement{ atCharge_v assign{result{atCharge_v}} }
}
checks {}
environment_checks {
    environment_check { lowBattery arguments {} read_variables {lowBattery_v} condition{lowBattery_v} }
    environment_check { atCharge arguments {} read_variables {atCharge_v} condition{atCharge_v} }
}
actions {
    action { goToStation
        arguments {} local_variables{} read_variables{} write_variables{} initial_values{}
        update { return_statement{result{success}} }
    }
    action { charging
        arguments {} local_variables{} read_variables{} write_variables{} initial_values{}
        update { return_statement{result{success}} }
    }
}
sub_trees {}
tree {
    composite {
        c0 sequence
        children {
            lowBattery {}
        composite {
            c1 selector
            children {
                atCharge {}
                goToStation {}
            }
        }
            charging {}
        }
    }
}
tick_prerequisite {True}
specifications {
    LTLSPEC {(next, (or, (success, lowBattery), (failure, lowBattery)))}
    LTLSPEC {(globally, (implies, (success, lowBattery), (next, (or, (success, atCharge), (failure, atCharge)))))}
    LTLSPEC {(globally, (implies, (failure, atCharge), (next, (or, (success, goToStation), (failure, goToStation), (running, goToStation)))))}
    LTLSPEC {(globally, (implies, (success, goToStation), (next, (or, (success, charging), (failure, charging), (running, charging)))))}
}
